# AI assistant (OpenAI-compatible chat-completions endpoint). Server-side only: never prefix with NEXT_PUBLIC_.
# Copy to .env.local and fill in. Without LLM_API_KEY the assistant shows an honest "not configured" message.
LLM_API_KEY=
# Default: https://api.openai.com/v1  (e.g. https://api.groq.com/openai/v1, https://openrouter.ai/api/v1)
LLM_BASE_URL=
# Default: gpt-4o-mini
LLM_MODEL=
